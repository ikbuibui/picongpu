if(TARGET @PROJECT_NAME@::@PROJECT_NAME@)
  return()
endif()

add_library(@PROJECT_NAME@::@PROJECT_NAME@ INTERFACE IMPORTED)
set_target_properties(
  @PROJECT_NAME@::@PROJECT_NAME@
  PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@mallocMC_INCLUDE_DESTINATION@"
    INTERFACE_LINK_LIBRARIES "alpaka::alpaka"
)
